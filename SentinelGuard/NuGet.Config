<?xml version="1.0" encoding="utf-8"?>
<!--
  Le NuGet.Config global de cette machine (%APPDATA%\NuGet\NuGet.Config) n'a
  aucune source configurée, ce qui bloquait toute restauration de package
  externe. Ce fichier local ajoute nuget.org, scopé à ce projet uniquement —
  il ne modifie rien en dehors de ce dossier.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
