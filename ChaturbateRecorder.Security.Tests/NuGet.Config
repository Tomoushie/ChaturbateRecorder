<?xml version="1.0" encoding="utf-8"?>
<!--
  Le NuGet.Config global de cette machine (%APPDATA%\NuGet\NuGet.Config) n'a
  aucune source configurée. Ce fichier local ajoute nuget.org, scopé à ce
  projet uniquement (voir aussi ChaturbateRecorder.Security\NuGet.Config,
  un dossier frère et non un parent, donc pas hérité automatiquement par
  résolution NuGet).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
