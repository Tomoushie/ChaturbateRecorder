<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      LES CONTRÔLES QUE WPF DESSINE LUI-MÊME, ramenés à la palette du projet.

      Ils remplacent `ThemedScrollBar`, `ThemedProgressBar`, `ThemedComboBox` et
      `ThemedListView` du WinForms — quatre contrôles PEINTS À LA MAIN, soit
      ~940 lignes, parce qu'aucun contrôle Windows ne se laissait recolorer.

      **L'ascenseur est le cas le plus parlant.** Côté WinForms il a fallu
      `SetWindowTheme(handle, "DarkMode_Explorer")` en P/Invoke, réappliqué sur
      `HandleCreated` parce que le handle n'existe pas toujours à l'appel — et
      le correctif de 114.0 a dû être refait une fois, certains ascenseurs
      restant blancs faute d'être câblés. Ici c'est un `Style`, il s'applique
      partout, et le mode de panne n'existe pas.

      **Styles IMPLICITES, sans x:Key** : ils touchent tout l'arbre. C'est
      voulu — le défaut de 114.0 n'était pas la couleur mais le MÉLANGE, un
      seul type de contrôle ayant été câblé.
    -->

    <!-- ===================== ASCENSEURS ===================== -->

    <Style x:Key="Nav.PouceInvisible" TargetType="RepeatButton">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Thumb" x:Key="Ascenseur.Pouce">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- 8 px de large dans 12 px de piste : le pouce ne touche
                         pas les bords, ce qui le distingue d'une bordure. -->
                    <Border x:Name="Corps" Width="8" CornerRadius="4"
                            HorizontalAlignment="Center"
                            Background="{DynamicResource Brush.Border}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Corps" Property="Background"
                                    Value="{DynamicResource Brush.FgMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource Nav.PouceInvisible}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Ascenseur.Pouce}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource Nav.PouceInvisible}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Les flèches de fin sont SUPPRIMÉES, pas masquées : personne ne
                 défile trois pixels à la fois, et elles coûtent 34 px de piste
                 utile sur une liste courte. -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                      Style="{StaticResource Nav.PouceInvisible}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Height="8" CornerRadius="4"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource Brush.Border}" />
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                                      Style="{StaticResource Nav.PouceInvisible}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== CASES À COCHER ===================== -->

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- BACKGROUND EXPLICITE, et c'est un correctif, pas une garniture.
             Sans lui, Control.Background garde le blanc par defaut de WPF —
             jamais PEINT (le gabarit ci-dessous ne le reference nulle part,
             il pose ses propres fonds en dur) mais toujours LISIBLE comme
             valeur de propriete. Un filet qui lit les proprietes plutot que
             les pixels peints (LeTexteDesDialoguesEstLisible) s'y est
             trompe : contraste mesure a 1,23 pour un texte pourtant bien
             blanc sur fond bien sombre a l'ecran, parce qu'il comparait
             contre ce blanc INERTE et jamais contre le vrai fond de fenetre.
             Corriger la PROPRIETE plutot que le filet : une valeur qui ne
             reflete pas ce qui est peint est un piege pour le prochain outil
             qui la lira, pas seulement pour celui-ci. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Boite" Width="16" Height="16"
                                CornerRadius="3" BorderThickness="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Input}"
                                BorderBrush="{DynamicResource Brush.Border}">
                            <!-- La coche est un TRACÉ et non le caractère « ✓ » :
                                 elle reste nette à toute échelle et suit la
                                 couleur du thème, comme les pictogrammes. -->
                            <Path x:Name="Coche"
                                  Data="M 3,8 L 6.5,11.5 L 13,4.5"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Visibility="Collapsed"
                                  Stroke="{DynamicResource Brush.AccentFg}" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Boite" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Boite" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Coche" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Boite" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== INTERRUPTEUR =====================

      L'interrupteur « auto » d'une carte de salon. Il remplace la CheckBox
      standard qui tenait sa place depuis la tranche « carte de salon », et
      reprend les mesures du contrôle WinForms dessiné à la main : 34x18, pouce
      de 14 px, 2 px de garde.

      **Un interrupteur et non une case, et ce n'est pas cosmétique** : une case
      dit « ce champ est vrai », un interrupteur dit « cette fonction est
      ARMÉE ». C'est bien de cela qu'il s'agit — une ligne n'est qu'un salon
      connu, c'est ce réglage qui engage la surveillance.
    -->
    <Style x:Key="Interrupteur" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <!-- Meme correctif que le CheckBox implicite ci-dessus, et pour la
             MEME raison mesuree : Control.Background gardait le blanc par
             defaut de WPF, jamais peint par ce gabarit (qui pose ses propres
             fonds en dur sur "Piste"/"Pouce"), mais lu comme le fond du
             texte par LeTexteDesDialoguesEstLisible : 1,23 de contraste
             mesure pour un texte pourtant correctement blanc sur fond
             sombre a l'ecran. Touchait deja "auto" sur la carte de salon,
             jamais mesure faute d'un dialogue teste qui l'utilisait. -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Piste" Width="34" Height="18"
                                CornerRadius="9" BorderThickness="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.Input}"
                                BorderBrush="{DynamicResource Brush.Border}">
                            <Ellipse x:Name="Pouce" Width="14" Height="14"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0"
                                     Fill="{DynamicResource Brush.FgMuted}" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Piste" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Piste" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <!-- Le pouce glisse a DROITE par son alignement, pas
                                 par une marge negative : la piste reste de
                                 largeur fixe quel que soit l'etat. -->
                            <Setter TargetName="Pouce" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Pouce" Property="Margin" Value="0,0,2,0" />
                            <Setter TargetName="Pouce" Property="Fill" Value="{DynamicResource Brush.AccentFg}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Piste" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== BARRES DE PROGRESSION ===================== -->

    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Input}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <!--
                    TROISIÈME REPRISE DU MÊME DÉFAUT (24-08, deux corrections
                    précédentes côté StreamsViewModel : voir son commentaire
                    de classe sur `Indeterminate`). Poser `IsIndeterminate`
                    est nécessaire mais ne suffisait PAS : ce gabarit ne lui
                    donnait AUCUN sens visuel — ni Trigger ni Storyboard —
                    donc PART_Indicator restait dimensionné sur Value/Maximum
                    dans les DEUX modes. Comme yt-dlp rend 100 % à chaque
                    fragment pour un direct, la barre restait figée PLEINE,
                    lue comme un enregistrement TERMINÉ. Trouvé par Tom en
                    testant contre un vrai direct — invisible sans lui,
                    comme les deux fois précédentes.

                    "Défilement" est un morceau INDÉPENDANT de PART_Indicator
                    (jamais géré par le calcul automatique du contrôle),
                    révélé et animé UNIQUEMENT par le déclencheur ci-dessous
                    — PART_Indicator reste inchangé pour le mode déterminé.
                    -->
                    <Grid ClipToBounds="True">
                        <Border CornerRadius="3" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator"
                                CornerRadius="3"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}" />
                        <Border x:Name="Defilement" Width="70" CornerRadius="3"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="DecalageDefilement" X="-70" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Defilement" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="AnimationDefilement">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="DecalageDefilement" Storyboard.TargetProperty="X"
                                                         From="-70" To="600" Duration="0:0:1.4"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="AnimationDefilement" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== LISTES DÉROULANTES ===================== -->

    <Style x:Key="Combo.Bouton" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Fond" CornerRadius="4" BorderThickness="1"
                            Background="{DynamicResource Brush.Input}"
                            BorderBrush="{DynamicResource Brush.Border}">
                        <Path x:Name="Chevron" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,8,0"
                              Data="M 0,0 L 4,4 L 8,0"
                              StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Stroke="{DynamicResource Brush.FgMuted}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Fond" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource Brush.Nav.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource Brush.Nav.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Combo.Bouton}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="8,0,24,0"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Slide">
                            <!-- La liste prend la surface de CARTE et non celle
                                 des champs : c'est une surface posée PAR-DESSUS
                                 la fenêtre, comme les cartes. -->
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    CornerRadius="6" BorderThickness="1" Margin="0,4,0,0"
                                    Background="{DynamicResource Brush.Card}"
                                    BorderBrush="{DynamicResource Brush.Border}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
