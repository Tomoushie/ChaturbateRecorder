<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- BOUTON PREMIUM, identité électrique (120.0).
         Couleurs figées à dessein : le violet premium ne suit pas le
         thème clair/sombre (même choix que Button.OnScrim).
         Tout vit dans le ControlTemplate : un Setter externe ne le
         traverserait pas (piège n°8 du projet).
         Animations en opacité et transformation uniquement : rien ne
         touche la disposition, le coût reste négligeable.

         Boucle AMBIANTE (deux petits arcs qui clignotent par paliers
         discrets, en continu) — DISTINCTE des éclairs PROCÉDURAUX du
         survol, propres à Views/PremiumButton.xaml(.cs) (Canvas superposé,
         régénéré à intervalle aléatoire pendant IsMouseOver). Les deux
         couches tournent ensemble, à la demande de Tom : celle-ci est
         l'identité visuelle au repos, l'autre réagit à la souris. -->

    <Geometry x:Key="Geo.Eclair">M13,2 L3,14 L10,14 L9,22 L21,10 L14,10 Z</Geometry>
    <Geometry x:Key="Geo.ArcHautDroit">M1,11 L5,7 L4,9 L9,4 L8,6 L14,1</Geometry>
    <Geometry x:Key="Geo.ArcBasGauche">M14,1 L10,5 L11,3 L6,8 L7,6 L1,11</Geometry>

    <LinearGradientBrush x:Key="Premium.Corps" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#5B21B6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Premium.CorpsSurvol" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8B5CF6" Offset="0" />
        <GradientStop Color="#6D28D9" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Premium.Liseret" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#C4B5FD" Offset="0" />
        <GradientStop Color="#4C1D95" Offset="1" />
    </LinearGradientBrush>

    <!-- Remplissage de l'ICÔNE fixe (Path Geo.Eclair) — à ne pas confondre
         avec `Premium.EclairProcedural` (Views/PremiumButton.xaml), le
         pinceau des traits d'éclair dessinés au survol : même famille de
         nom, deux objets différents, volontairement séparés pour qu'un
         changement de l'un ne touche jamais l'autre par erreur. -->
    <LinearGradientBrush x:Key="Premium.Eclair" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0" />
        <GradientStop Color="#DDD6FE" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Premium.Reflet" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#66FFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <Style x:Key="Button.Premium" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Echelle" />
                        </Grid.RenderTransform>

                        <!-- Halo respirant, faible opacité -->
                        <Border x:Name="Halo" Margin="-9" CornerRadius="28"
                                Background="#7C3AED" Opacity="0.25" IsHitTestVisible="False">
                            <Border.Effect>
                                <BlurEffect Radius="12" />
                            </Border.Effect>
                        </Border>

                        <!-- Corps : dégradé + liseré = profondeur -->
                        <Border x:Name="Corps" CornerRadius="20"
                                Background="{StaticResource Premium.Corps}"
                                BorderBrush="{StaticResource Premium.Liseret}"
                                BorderThickness="1">
                            <Grid ClipToBounds="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Éclair : copie floue dessous (lueur),
                                     trait net dessus, scintillement discret -->
                                <Grid x:Name="Eclair" Grid.Column="0"
                                      Width="12" Height="14" Margin="14,0,7,0">
                                    <Path Data="{StaticResource Geo.Eclair}"
                                          Fill="#A855F7" Opacity="0.8">
                                        <Path.Effect>
                                            <BlurEffect Radius="3" />
                                        </Path.Effect>
                                    </Path>
                                    <Path Data="{StaticResource Geo.Eclair}"
                                          Fill="{StaticResource Premium.Eclair}" />
                                </Grid>

                                <ContentPresenter Grid.Column="1" Margin="0,0,16,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />

                                <!-- Highlight vitreux, moitié haute -->
                                <Border Grid.ColumnSpan="2" IsHitTestVisible="False"
                                        CornerRadius="19" VerticalAlignment="Top"
                                        Height="18" Margin="1,1,1,0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#33FFFFFF" Offset="0" />
                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Reflet balayé : balayage rapide puis pause -->
                                <Border Grid.ColumnSpan="2" IsHitTestVisible="False"
                                        ClipToBounds="True" CornerRadius="19">
                                    <Border x:Name="Reflet" Width="70" Height="90"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Opacity="0"
                                            Background="{StaticResource Premium.Reflet}">
                                        <Border.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform Angle="20" />
                                                <TranslateTransform x:Name="RefletX" X="-90" />
                                            </TransformGroup>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Arcs électriques AU-DESSUS du corps, débordant du
                             bord comme une décharge. Déclarés après le corps
                             pour passer devant. -->
                        <Grid x:Name="ArcHautDroit" Opacity="0" IsHitTestVisible="False"
                              HorizontalAlignment="Right" VerticalAlignment="Top"
                              Width="16" Height="12" Margin="0,-7,-5,0">
                            <Path Data="{StaticResource Geo.ArcHautDroit}" Stroke="#A855F7"
                                  StrokeThickness="2.5" Fill="Transparent" StrokeLineJoin="Miter">
                                <Path.Effect>
                                    <BlurEffect Radius="2" />
                                </Path.Effect>
                            </Path>
                            <Path Data="{StaticResource Geo.ArcHautDroit}" Stroke="#F5F3FF"
                                  StrokeThickness="1" Fill="Transparent" />
                        </Grid>

                        <Grid x:Name="ArcBasGauche" Opacity="0" IsHitTestVisible="False"
                              HorizontalAlignment="Left" VerticalAlignment="Bottom"
                              Width="16" Height="12" Margin="-5,0,0,-7">
                            <Path Data="{StaticResource Geo.ArcBasGauche}" Stroke="#A855F7"
                                  StrokeThickness="2.5" Fill="Transparent" StrokeLineJoin="Miter">
                                <Path.Effect>
                                    <BlurEffect Radius="2" />
                                </Path.Effect>
                            </Path>
                            <Path Data="{StaticResource Geo.ArcBasGauche}" Stroke="#F5F3FF"
                                  StrokeThickness="1" Fill="Transparent" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Vie électrique, boucle 3,2 s. Les décharges sont
                             en paliers DISCRETS : une étincelle saute, elle
                             ne glisse pas. Arcs décalés dans le temps pour
                             ne jamais clignoter ensemble. -->
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">

                                    <DoubleAnimationUsingKeyFrames
                                        Storyboard.TargetName="Halo"
                                        Storyboard.TargetProperty="Opacity"
                                        Duration="0:0:3.2">
                                        <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:0" />
                                        <LinearDoubleKeyFrame Value="0.45" KeyTime="0:0:1.6" />
                                        <LinearDoubleKeyFrame Value="0.25" KeyTime="0:0:3.2" />
                                    </DoubleAnimationUsingKeyFrames>

                                    <!-- Scintillement de l'éclair -->
                                    <DoubleAnimationUsingKeyFrames
                                        Storyboard.TargetName="Eclair"
                                        Storyboard.TargetProperty="Opacity"
                                        Duration="0:0:3.2">
                                        <DiscreteDoubleKeyFrame Value="1" KeyTime="0:0:0" />
                                        <DiscreteDoubleKeyFrame Value="0.55" KeyTime="0:0:1.05" />
                                        <DiscreteDoubleKeyFrame Value="1" KeyTime="0:0:1.15" />
                                        <DiscreteDoubleKeyFrame Value="0.7" KeyTime="0:0:2.30" />
                                        <DiscreteDoubleKeyFrame Value="1" KeyTime="0:0:2.40" />
                                    </DoubleAnimationUsingKeyFrames>

                                    <!-- Décharge haut-droit, 0,9 s à 1,25 s -->
                                    <DoubleAnimationUsingKeyFrames
                                        Storyboard.TargetName="ArcHautDroit"
                                        Storyboard.TargetProperty="Opacity"
                                        Duration="0:0:3.2">
                                        <DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:0" />
                                        <DiscreteDoubleKeyFrame Value="0.9" KeyTime="0:0:0.90" />
                                        <DiscreteDoubleKeyFrame Value="0.25" KeyTime="0:0:1.00" />
                                        <DiscreteDoubleKeyFrame Value="0.8" KeyTime="0:0:1.08" />
                                        <DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:1.25" />
                                    </DoubleAnimationUsingKeyFrames>

                                    <!-- Décharge bas-gauche, 2,1 s à 2,45 s -->
                                    <DoubleAnimationUsingKeyFrames
                                        Storyboard.TargetName="ArcBasGauche"
                                        Storyboard.TargetProperty="Opacity"
                                        Duration="0:0:3.2">
                                        <DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:0" />
                                        <DiscreteDoubleKeyFrame Value="0.85" KeyTime="0:0:2.10" />
                                        <DiscreteDoubleKeyFrame Value="0.2" KeyTime="0:0:2.20" />
                                        <DiscreteDoubleKeyFrame Value="0.75" KeyTime="0:0:2.28" />
                                        <DiscreteDoubleKeyFrame Value="0" KeyTime="0:0:2.45" />
                                    </DoubleAnimationUsingKeyFrames>

                                    <!-- Reflet balayé -->
                                    <DoubleAnimationUsingKeyFrames
                                        Storyboard.TargetName="RefletX"
                                        Storyboard.TargetProperty="X"
                                        Duration="0:0:3.2">
                                        <LinearDoubleKeyFrame Value="-90" KeyTime="0:0:0.8" />
                                        <LinearDoubleKeyFrame Value="320" KeyTime="0:0:1.5" />
                                        <LinearDoubleKeyFrame Value="320" KeyTime="0:0:3.2" />
                                    </DoubleAnimationUsingKeyFrames>
                                    <DoubleAnimationUsingKeyFrames
                                        Storyboard.TargetName="Reflet"
                                        Storyboard.TargetProperty="Opacity"
                                        Duration="0:0:3.2">
                                        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.8" />
                                        <LinearDoubleKeyFrame Value="0.8" KeyTime="0:0:1.05" />
                                        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1.5" />
                                        <LinearDoubleKeyFrame Value="0" KeyTime="0:0:3.2" />
                                    </DoubleAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- Survol : éclaircir + zoom léger -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Corps" Property="Background"
                                    Value="{StaticResource Premium.CorpsSurvol}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Echelle"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.04" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="Echelle"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.04" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Echelle"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1" Duration="0:0:0.2" />
                                        <DoubleAnimation Storyboard.TargetName="Echelle"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!-- Pressé : resserrer -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Echelle"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="0.97" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="Echelle"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="0.97" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Echelle"
                                                         Storyboard.TargetProperty="ScaleX"
                                                         To="1.04" Duration="0:0:0.12" />
                                        <DoubleAnimation Storyboard.TargetName="Echelle"
                                                         Storyboard.TargetProperty="ScaleY"
                                                         To="1.04" Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
