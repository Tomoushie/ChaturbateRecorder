        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Btn.Secondary.Fg}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Btn.Secondary.Fill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Btn.Secondary.Border}"/>
        <Setter Property="Template">
