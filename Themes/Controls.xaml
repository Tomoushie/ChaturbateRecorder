<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Rayon de 6 px et remplissage de 10 px : ce sont les valeurs du ThemedButton WinForms (CornerRadius, EdgePadding), reprises pour que les deux interfaces ne divergent pas pendant la migration. Le survol et l'appui ne sont PAS des Setters de couleur en dur : ils pointent sur des pinceaux que ThemeManager recalcule depuis la palette. -->
    <Style x:Key="Button.Primary" TargetType="Button">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Btn.Primary.Fg}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Btn.Primary.Fill}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Btn.Primary.Border}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" CornerRadius="6" BorderThickness="1" Background="{DynamicResource Brush.Btn.Primary.Fill}" BorderBrush="{DynamicResource Brush.Btn.Primary.Border}">
                        <ContentPresenter x:Name="Contenu" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource Brush.Btn.Primary.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource Brush.Btn.Primary.Pressed}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Fond" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            <Setter TargetName="Fond" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fond" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Button.Secondary" TargetType="Button">
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
