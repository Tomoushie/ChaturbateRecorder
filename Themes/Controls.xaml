    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.FgMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- Deux niveaux de lecture (39.0). Sans le second, un intitule de champ et la donnee qu'il annonce ont exactement le meme poids, et l'oeil n'a aucun repere pour parcourir l'ecran. -->
    <Style x:Key="Surface.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.18" Color="Black"/>
            </Setter.Value>
        </Setter>
    </Style>
    <!--
      STYLE IMPLICITE, en plus de la cle : un TextBox pose sans style gardait le
      fond BLANC de WPF, invisible au build et bien visible en theme sombre.
      Les fenetres qui veulent un fond transparent le posent en valeur LOCALE,
      qui l'emporte sur un Setter de style — elles ne sont donc pas touchees.
    -->
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
    </Style>

    <Style x:Key="Surface.Input" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Fg}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Input}">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- La fenetre est un fond sur lequel sont posees des cartes, qui portent elles-memes champs et listes. Avant 39.0 les cartes prenaient la couleur du fond : elles n'existaient que par un lisere de 1 px, d'ou un ecran entierement plat. -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Fg}"/>
    </Style>
    <!--
      IL N'Y A VOLONTAIREMENT PAS DE STYLE IMPLICITE SUR TextBlock, et le
      retirer était un CORRECTIF, pas un allègement.

      Il en existait un, posé pour que « tout TextBlock non stylisé ne reste
      pas noir en thème sombre ». Le raisonnement était faux : `Foreground` est
      une propriété HÉRITÉE, et le style de `Window` ci-dessus la pose déjà
      pour tout l'arbre. En revanche un Setter explicite BAT l'héritage — donc
      ce style volait sa couleur à tout texte placé dans un conteneur qui en
      impose une autre.

      Mesuré au pixel sur le libellé « Retirer » d'un bouton Danger : (26,26,26)
      en thème clair et (232,232,232) en sombre, c'est-à-dire `Brush.Fg` dans
      les deux cas — au lieu du rouge du rôle. Tous les boutons Primary et
      Danger étaient touchés, et rien ne le signalait.
    -->
</ResourceDictionary>