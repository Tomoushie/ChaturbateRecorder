                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fond" CornerRadius="6" BorderThickness="1" Background="{DynamicResource Brush.Btn.Danger.Fill}" BorderBrush="{DynamicResource Brush.Btn.Danger.Border}">
                        <ContentPresenter x:Name="Contenu" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fond" Property="Background" Value="{DynamicResource Brush.Btn.Danger.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
