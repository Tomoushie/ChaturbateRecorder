<Window x:Class="ChaturbateRecorderApp.Views.TutorialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guide de démarrage"
        Width="560" Height="420"
        MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{Binding EtapeCourante.Titre}"
                   FontSize="18" FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource Brush.Fg}" />

        <ScrollViewer Grid.Row="1" Margin="0,12,0,0"
                      VerticalScrollBarVisibility="Auto">
            <TextBlock Text="{Binding EtapeCourante.Corps}"
                       TextWrapping="Wrap"
                       LineHeight="20"
                       Foreground="{DynamicResource Brush.Fg}" />
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left"
                       Style="{StaticResource Text.Caption}"
                       Text="{Binding Progression}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <!-- « Précédent » est DÉSACTIVÉ et non masqué à la première
                     étape : un bouton qui disparaît fait sauter le second de
                     place, et on clique alors à côté. -->
                <Button Style="{StaticResource Button.Secondary}"
                        Content="{Binding LibellePrecedent}"
                        IsEnabled="{Binding EstPremiere, Converter={StaticResource InverseBooleanConverter}}"
                        Command="{Binding PrecedentCommand}" />

                <!-- Le MÊME bouton avance et termine : un « Terminer » séparé
                     resterait inactif sept étapes sur huit. -->
                <Button Margin="8,0,0,0" MinWidth="110"
                        Style="{StaticResource Button.Primary}"
                        Content="{Binding LibelleSuivant}"
                        Command="{Binding SuivantCommand}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
