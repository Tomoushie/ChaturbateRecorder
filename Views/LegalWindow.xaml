<Window x:Class="ChaturbateRecorderApp.Views.LegalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Légalité (Belgique)"
        Width="680" Height="600"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner">

    <!--
      LE TEXTE VIENT DE LA TABLE DE CHAÎNES (`legal.body`), traduit en français
      ET en anglais depuis 98.0. Le recopier ici en aurait fait une seconde
      version à maintenir — et c'est le genre de texte où deux versions qui
      divergent posent un vrai problème, pas un défaut cosmétique.
    -->

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <!-- Sélectionnable : quelqu'un peut vouloir en citer un passage,
                 par exemple pour demander un avis à un juriste. -->
            <TextBox x:Name="Corps"
                     IsReadOnly="True"
                     BorderThickness="0"
                     Background="Transparent"
                     Foreground="{DynamicResource Brush.Fg}"
                     TextWrapping="Wrap"
                     Padding="4" />
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0"
                    HorizontalAlignment="Right">
            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0"
                       Style="{StaticResource Text.Caption}"
                       Text="Texte informatif, il ne constitue pas un avis juridique." />
            <Button Style="{StaticResource Button.Primary}"
                    Content="Fermer" Click="Fermer_Click" />
        </StackPanel>
    </Grid>
</Window>
