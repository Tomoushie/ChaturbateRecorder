<Window x:Class="ChaturbateRecorderApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chaturbate Recorder"
        Width="896" Height="720"
        MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterScreen">

    <!--
      896 = 196 (barre) + 700 (contenu), et 720 de haut : ce sont les mesures
      du WinForms après la refonte 97.0. Les reprendre évite de redécouvrir à
      quelle largeur le contenu commence à se serrer.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0"
                 Style="{StaticResource Nav.SideBar}"
                 ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection, Mode=TwoWay}" />

        <!--
          ZONE DE CONTENU — provisoire. Les quatre vues (Enregistrer,
          Historique, Réglages, Soutenir) sont la tranche suivante ; en
          attendant, l'écran affiche quelle section est active, ce qui suffit à
          éprouver la navigation, le thème et la bascule de langue.
        -->
        <Border Grid.Column="1" Margin="16" Style="{StaticResource Surface.Card}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Body}"
                           FontSize="20" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Text="{Binding SelectedSection.Label}" />
                <TextBlock Style="{StaticResource Text.Caption}"
                           Margin="0,8,0,0" HorizontalAlignment="Center"
                           Text="{Binding SelectedSection.Key, StringFormat='section « {0} » — vue à porter'}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
