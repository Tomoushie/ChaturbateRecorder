<Window x:Class="ChaturbateRecorderApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chaturbate Recorder"
        Width="896" Height="720"
        MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        xmlns:vues="clr-namespace:ChaturbateRecorderApp.Views"
        xmlns:ui="clr-namespace:ChaturbateRecorderApp.UI">

    <Window.Resources>
        <DataTemplate x:Key="Section.Streams">
            <vues:StreamsView DataContext="{Binding Streams}" />
        </DataTemplate>

        <DataTemplate x:Key="Section.History">
            <vues:HistoryView DataContext="{Binding Historique}" />
        </DataTemplate>

        <DataTemplate x:Key="Section.Settings">
            <vues:SettingsView DataContext="{Binding Reglages}" />
        </DataTemplate>

        <DataTemplate x:Key="Section.Support">
            <vues:SupportView DataContext="{Binding Soutien}" />
        </DataTemplate>

        <DataTemplate x:Key="Section.APorter">
            <Border Margin="16" Style="{StaticResource Surface.Card}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.Body}"
                               FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Text="{Binding SelectedSection.Label}" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Margin="0,8,0,0" HorizontalAlignment="Center"
                               Text="{Binding SelectedSection.Key, StringFormat='section « {0} » — vue à porter'}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!--
      896 = 196 (barre) + 700 (contenu), et 720 de haut : ce sont les mesures
      du WinForms après la refonte 97.0. Les reprendre évite de redécouvrir à
      quelle largeur le contenu commence à se serrer.
    -->

    <Grid x:Name="GrilleRacine">
        <Grid.RowDefinitions>
            <!-- Bannière « licence refusée » (2.2.0) : ligne Auto pour
                 POUSSER le contenu au lieu de le recouvrir. Masquée au repos,
                 elle ne coûte aucune hauteur. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
          AFFICHÉE SEULEMENT si un licence.key existe mais a été refusé (voir
          MainWindow.xaml.cs). Un utilisateur qui n'a jamais acheté ne doit pas
          voir d'avertissement permanent : le bouton flottant « Passer à
          Premium » suffit. Ici, quelqu'un a PAYÉ et croit être activé — le
          silence est le vrai défaut.
        -->
        <Border x:Name="BanniereLicence" Grid.Row="0" Margin="16,12,16,0"
                Padding="12,10" CornerRadius="6"
                Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Fg}"
                               Text="{ui:Str premium.bannerTitle}" />
                    <TextBlock x:Name="TexteBanniereLicence" Margin="0,2,0,0"
                               TextWrapping="Wrap"
                               Style="{StaticResource Text.Caption}" />
                </StackPanel>

                <Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                        Style="{StaticResource Button.Secondary}"
                        Content="{ui:Str premium.bannerAction}"
                        Click="BanniereLicence_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     Style="{StaticResource Nav.SideBar}"
                     ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection, Mode=TwoWay}" />

            <!--
              ZONE DE CONTENU. Seule « Enregistrer » est portée ; les trois autres
              affichent encore leur carton. Le contenu est choisi par la CLÉ de la
              section et non par son libellé, qui change avec la langue.
            -->
            <ContentControl Grid.Column="1" Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource Section.APorter}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection.Key}" Value="streams">
                                <Setter Property="ContentTemplate" Value="{StaticResource Section.Streams}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection.Key}" Value="history">
                                <Setter Property="ContentTemplate" Value="{StaticResource Section.History}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection.Key}" Value="settings">
                                <Setter Property="ContentTemplate" Value="{StaticResource Section.Settings}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedSection.Key}" Value="support">
                                <Setter Property="ContentTemplate" Value="{StaticResource Section.Support}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Grid>

        <!--
          BOUTON PREMIUM FLOTTANT (120.0) : PAS déclaré ici. Il n'est ajouté à
          GrilleRacine QUE depuis le code-behind, et seulement si l'app n'est
          pas licenciée — voir MainWindow.xaml.cs. Un `Visibility.Collapsed`
          posé après coup NE SUFFIT PAS : un Control Collapsed n'exécute
          jamais Measure, donc n'applique jamais son ControlTemplate (piège
          n°5 déjà documenté) — mais le déclencheur `EventTrigger
          RoutedEvent="Loaded"` de Button.Premium (Themes/Premium.xaml, pour
          l'animation ambiante) se déclenche quand même et plante en cherchant
          un élément nommé du gabarit jamais matérialisé
          (InvalidOperationException, trouvé par Tom contre le vrai
          exécutable). Ne jamais le construire du tout est le seul correctif
          fiable, pas une histoire de Visibility.
        -->
    </Grid>
</Window>
