<!-- Views/MonitorView.xaml -->
<UserControl x:Class="ChaturbateRecorderApp.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:models="clr-namespace:ChaturbateRecorderApp.Models"
             xmlns:viewModels="clr-namespace:ChaturbateRecorderApp.ViewModels"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:ChaturbateRecorderApp.Converters"  <!-- Déclaration du namespace pour le convertisseur -->
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewModels:MonitorViewModel}">

    <!-- Déclaration du convertisseur comme ressource locale -->
    <UserControl.Resources>
        <converters:StatusToVisibilityConverter x:Key="StatusToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Zone d'ajout -->
            <RowDefinition Height="*"/>   <!-- Liste des salons -->
        </Grid.RowDefinitions>

        <!-- Zone d'ajout d'un nouveau salon -->
        <Border Grid.Row="0" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="NewRoomUrlTextBox"
                         Text="{Binding NewRoomUrl, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="URL du salon à surveiller"
                         Width="300"
                         Margin="0,0,10,0"/>
                <Button Content="Ajouter"
                        Command="{Binding AddRoomCommand}"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Border>

        <!-- Liste/Grille des salons surveillés -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl ItemsSource="{Binding MonitoredRooms}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:MonitoredRoom}">
                        <Border Margin="5" Padding="10" BorderBrush="Gray" BorderThickness="1" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Image + Détails -->
                                    <RowDefinition Height="Auto"/> <!-- Boutons -->
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Image -->
                                    <ColumnDefinition Width="*"/>   <!-- Détails -->
                                    <ColumnDefinition Width="Auto"/> <!-- Bouton Supprimer -->
                                </Grid.ColumnDefinitions>

                                <!-- Vignette -->
                                <Image Grid.Row="0" Grid.Column="0"
                                       Source="{Binding ThumbnailPath}"
                                       Width="160" Height="90" Stretch="Uniform"
                                       Margin="0,0,10,0"/>

                                <!-- Détails -->
                                <StackPanel Grid.Row="0" Grid.Column="1" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Url}" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}"/>
                                    <TextBlock Text="{Binding Status, StringFormat='Statut : {0}'}" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding RecordingStatus, StringFormat='Enregistrement : {0}'}" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2,0,0"/> <!-- Nouvelle info -->
                                    <TextBlock Text="{Binding LastCheckTime, StringFormat='Dernière vérif : {0:HH:mm:ss}'}" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Bouton Supprimer -->
                                <Button Grid.Row="0" Grid.Column="2"
                                        Content="Supprimer"
                                        Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.RemoveSelectedRoomCommand}"
                                        CommandParameter="{Binding .}"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Foreground="Red"/>

                                <!-- Boutons Enregistrement -->
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <!-- Le DataContext de ces boutons est toujours le MonitoredRoom -->
                                    <!-- On passe le MonitoredRoom lui-même comme paramètre -->
                                    <Button Content="Démarrer Enreg."
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.StartRecordingCommand}"
                                            CommandParameter="{Binding .}" <!-- Passe le MonitoredRoom courant -->
                                            Visibility="{Binding Status, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter='En ligne'}" <!-- Utilise le convertisseur local -->
                                            Style="{StaticResource MaterialDesignRaisedDarkButton}"
                                            Margin="0,0,5,0"
                                            IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.StartRecordingCommand.IsExecutionAllowed}"/> <!-- Lier l'activation à la commande -->

                                    <Button Content="Arrêter Enreg."
                                            Command="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.StopRecordingCommand}"
                                            CommandParameter="{Binding .}"
                                            Visibility="{Binding RecordingStatus, Converter={StaticResource StatusToVisibilityConverter}, ConverterParameter='En cours'}" <!-- Utilise le convertisseur local -->
                                            Style="{StaticResource MaterialDesignRaisedLightButton}"
                                            Margin="5,0,0,0"
                                            IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=DataContext.StopRecordingCommand.IsExecutionAllowed}"/>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>