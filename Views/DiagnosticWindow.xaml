<Window x:Class="ChaturbateRecorderApp.Views.DiagnosticWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:ChaturbateRecorderApp.UI"
        Title="Diagnostic"
        Width="640" Height="520"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Le rapport est un TextBox en lecture seule et non un TextBlock :
             on veut pouvoir en SÉLECTIONNER une partie. Quelqu'un qui signale
             un problème recopie rarement tout le rapport, et « Copier » ne
             convient pas quand on ne veut transmettre qu'une section. -->
        <Border Grid.Row="0"
                Background="{DynamicResource Brush.Input}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="Rapport"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource Brush.Fg}"
                         FontFamily="Consolas"
                         FontSize="12"
                         Padding="10"
                         TextWrapping="NoWrap" />
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Style="{StaticResource Button.Secondary}"
                    Content="{ui:Str button.copy}" Click="Copier_Click" />
            <Button Margin="8,0,0,0"
                    Style="{StaticResource Button.Secondary}"
                    Content="{ui:Str button.refresh}" Click="Actualiser_Click" />
            <Button Margin="8,0,0,0"
                    HorizontalAlignment="Right"
                    Style="{StaticResource Button.Primary}"
                    Content="{ui:Str button.close}" Click="Fermer_Click" />
        </StackPanel>
    </Grid>
</Window>
