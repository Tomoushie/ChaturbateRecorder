<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>

    <!--
      WinForms EST ACTIVE, uniquement pour `NotifyIcon` : .NET n'offre aucune
      autre icône de zone de notification, et WPF n'en a pas.

      Choix assumé face à la dépendance NuGet qui fait la même chose : c'est une
      référence de FRAMEWORK, déjà installée avec le runtime, pas un paquet
      tiers de plus dans un projet qui vérifie les empreintes de ses binaires et
      publie un SBOM. L'ironie d'activer WinForms dans une migration qui le
      quitte est réelle mais superficielle — aucune FENÊTRE WinForms n'existe
      ici, seulement l'objet de zone de notification.

      Conséquence à connaître : `Application` devient ambigu entre
      `System.Windows.Application` et `System.Windows.Forms.Application`. Le
      code qualifie donc complètement partout où les deux se rencontrent.
    -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!--
      MÊME AssemblyName que la version WinForms, et ce n'est pas cosmétique :
      l'installateur (setup.exe) et le vérificateur de mise à jour interne
      ciblent tous deux `ChaturbateRecorder.exe`. Renommer ici casserait la
      mise à jour des installations existantes, en silence.
    -->
    <AssemblyName>ChaturbateRecorder</AssemblyName>

    <!--
      RootNamespace identique à celui de l'app WinForms : les 21 services
      portés gardent alors `namespace ChaturbateRecorderApp.Services` mot pour
      mot, ce qui supprime une passe de renommage sur ~3 000 lignes — et avec
      elle le risque d'en manquer une.
    -->
    <RootNamespace>ChaturbateRecorderApp</RootNamespace>

    <Version>1.37.0</Version>

    <!--
      ICONE DE L'APPLICATION. Elle manquait : l'executable, la barre des taches
      et la zone de notification tombaient tous sur l'icone generique de
      Windows. `TrayIcon.ExtraireIcone` lit justement celle de l'exe.

      Prise dans les Assets du depot WinForms et NON dupliquee : c'est la meme
      identite visuelle, et deux fichiers finiraient par diverger.
    -->
    <ApplicationIcon>..\ChaturbateRecorderApp\Assets\app.ico</ApplicationIcon>

    <!-- Voir le csproj WinForms : permet à `dotnet restore` de résoudre les
         FrameworkReference de bureau depuis un runner non-Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- X509Certificate.CreateFromSignedFile reste la seule API BCL qui
         extrait le certificat Authenticode d'un PE signé (cf. csproj WinForms). -->
    <NoWarn>SYSLIB0057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      LES QUATRE NOMS QUE WinForms REND AMBIGUS, tranches ICI et une seule fois.

      Activer WinForms pour NotifyIcon fait entrer System.Drawing et
      System.Windows.Forms par les usings implicites : `Application`, `Color`,
      `Brush` et `UserControl` existent alors dans deux mondes. Un alias par
      fichier aurait disperse la decision dans une dizaine d'endroits, et le
      onzieme fichier ecrit l'aurait oublie.

      DANS CE PROJET, CES QUATRE NOMS DESIGNENT TOUJOURS WPF. Un jour ou une
      couleur System.Drawing serait reellement necessaire, il faudra la
      qualifier completement — ce qui est exactement le bon rapport, vu qu'il
      n'y en a aucune aujourd'hui.
    -->
    <Using Include="System.Windows.Application" Alias="Application" />
    <Using Include="System.Windows.Media.Color" Alias="Color" />
    <Using Include="System.Windows.Media.Brush" Alias="Brush" />
    <Using Include="System.Windows.Controls.UserControl" Alias="UserControl" />
    <Using Include="System.Windows.Clipboard" Alias="Clipboard" />
    <!-- Sixieme ambiguite de la meme famille, apparue avec l'extension de
         balisage de traduction : System.Windows.Forms.Binding existe aussi. -->
    <Using Include="System.Windows.Data.Binding" Alias="Binding" />
    <!-- Quatre de plus, meme famille : le rendu hors application manipule des
         elements et des coordonnees WPF. `Services/TrayIcon.cs` prefixe deja
         tout ce qu'il prend a WinForms par `WinForms.`, donc rien ne perd son
         type ici. -->
    <Using Include="System.Windows.Controls.Button" Alias="Button" />
    <Using Include="System.Windows.Controls.TextBox" Alias="TextBox" />
    <Using Include="System.Windows.Size" Alias="Size" />
    <Using Include="System.Windows.Point" Alias="Point" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <!-- L'ID est bien `.Wpf` : `Microsoft.Xaml.Behaviors` seul n'existe pas
         sur nuget.org (NU1101), et c'est ce que déclarait le squelette. -->
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
  </ItemGroup>

  <ItemGroup>
    <!--
      ProjectReference et non PackageReference, pour la raison déjà tranchée
      côté WinForms : la version publiée sur nuget.org est toujours en retard
      d'un correctif sur le source du dépôt, et dépendre d'un paquet qu'on
      publie soi-même imposerait de publier avant de pouvoir corriger.
      Le projet vit dans le dépôt public, à côté ; c'est le même fichier que
      consomme l'application WinForms — pas une copie.
    -->
    <ProjectReference Include="..\ChaturbateRecorderApp\SentinelGuard\SentinelGuard.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      yt-dlp.exe ET ffmpeg.exe COPIÉS À CÔTÉ DE L'EXÉCUTABLE, sans quoi
      l'application démarre mais ne peut RIEN faire : `AppConfig` les cherche
      dans `AppContext.BaseDirectory`, et le sondage comme la capture échouent
      en silence si le fichier manque.

      Ils sont pris dans le dossier `Tools\` du dépôt WinForms, PAS recopiés
      ici : ffmpeg pèse 242 Mo, en garder deux exemplaires sur le disque n'a
      aucun sens pendant la migration, et leurs empreintes SHA-256 sont tenues
      à jour dans un seul `AppConfig.cs`.

      Ne JAMAIS les inclure dans un ZIP de release : ffmpeg est sous licence
      GPL — c'est la règle du dépôt public.
    -->
    <None Include="..\ChaturbateRecorderApp\Tools\yt-dlp.exe"
          Condition="Exists('..\ChaturbateRecorderApp\Tools\yt-dlp.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>yt-dlp.exe</Link>
    </None>
    <None Include="..\ChaturbateRecorderApp\Tools\ffmpeg.exe"
          Condition="Exists('..\ChaturbateRecorderApp\Tools\ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ffmpeg.exe</Link>
    </None>
    <None Include="..\ChaturbateRecorderApp\Assets\donate_qr.png"
          Condition="Exists('..\ChaturbateRecorderApp\Assets\donate_qr.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>donate_qr.png</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Tests\ est un projet A PART. Sans ces retraits, le SDK globalise ses
         .cs dans CE projet-ci, qui n'a ni xUnit ni ses paquets — c'est le meme
         piege que le csproj WinForms documente pour Tests\ et SentinelGuard\. -->
    <Compile Remove="Tests\**" />
    <Page Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!--
      AUCUNE référence à StreamRecorderPro, et c'est structurel : le module
      payant est chargé par RÉFLEXION (`Services/PremiumModuleService.cs`).
      Une référence de compilation obligerait le module à connaître l'identité
      de cet assembly — or la variante portable est publiée en
      PublishSingleFile auto-contenue, où ce liage ne casse qu'à l'exécution,
      chez l'utilisateur, sur la variante la moins testée.
    -->
  </ItemGroup>

</Project>
