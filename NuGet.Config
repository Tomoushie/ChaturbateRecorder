<?xml version="1.0" encoding="utf-8"?>
<!--
  Le NuGet.Config global de cette machine (%APPDATA%\NuGet\NuGet.Config) n'a
  aucune source configurée : sans ce fichier local, toute restauration échoue
  en NU1100, y compris celle des runtime packs d'un publish self-contained.
  Copie de celui du dossier WinForms — il est scopé au dossier qui le contient,
  donc il ne couvre pas ce projet-ci depuis là-bas.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
