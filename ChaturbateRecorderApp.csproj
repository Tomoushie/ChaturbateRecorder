<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!--
      Permet à "dotnet restore" de résoudre le FrameworkReference WinForms
      depuis un OS non-Windows (ex: le job GitHub natif "Automatic Dependency
      Submission (NuGet)", qui tourne sur ubuntu-latest et échouait avec
      NETSDK1100 sans ce flag). Sans effet sur un build Windows classique.
    -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ChaturbateRecorder</AssemblyName>
    <RootNamespace>ChaturbateRecorderApp</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.28.1</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!--
      SYSLIB0057 : X509Certificate.CreateFromSignedFile(...) est marquée obsolète
      depuis .NET 8, mais reste la seule API de la BCL permettant d'extraire le
      certificat Authenticode signataire d'un binaire PE déjà signé. Il n'existe
      pas d'équivalent direct sans dépendance tierce (ex: AuthenticodeExaminer)
      ou P/Invoke vers WinTrust (WinVerifyTrust). On désactive donc ce warning
      spécifique en connaissance de cause plutôt que de le supprimer partout au
      niveau du code avec des #pragma disséminés.
    -->
    <NoWarn>SYSLIB0057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Rendu SVG -> Bitmap à la volée pour les icônes vectorielles (3.1). -->
    <PackageReference Include="Svg" Version="3.4.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests/ est un projet à part (ChaturbateRecorderApp.Tests.csproj) : à
         exclure de l'inclusion récursive par défaut du SDK, sinon ce projet-ci
         essaie aussi de compiler les fichiers de test (et leurs packages
         xUnit, absents ici). Même chose pour SentinelGuard(.Tests)/,
         package extrait (30.0) vivant dans des .csproj séparés à côté. -->
    <Compile Remove="Tests\**" />
    <Content Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Compile Remove="SentinelGuard\**" />
    <Content Remove="SentinelGuard\**" />
    <None Remove="SentinelGuard\**" />
    <Compile Remove="SentinelGuard.Tests\**" />
    <Content Remove="SentinelGuard.Tests\**" />
    <None Remove="SentinelGuard.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Le QR code de don est copié à côté de l'exécutable au build. -->
    <None Include="Assets\donate_qr.png" Condition="Exists('Assets\donate_qr.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>donate_qr.png</Link>
    </None>
    <!--
      yt-dlp.exe et ffmpeg.exe sont conservés dans Tools\ (hors du dossier bin\
      de build, qu'un dotnet clean peut effacer) et copiés à côté de l'exécutable
      à chaque build. Leur hash SHA256 doit être tenu à jour dans AppConfig.cs
      (YtDlpExpectedSha256 / FfmpegExpectedSha256) à chaque mise à jour de binaire.
    -->
    <None Include="Tools\yt-dlp.exe" Condition="Exists('Tools\yt-dlp.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>yt-dlp.exe</Link>
    </None>
    <None Include="Tools\ffmpeg.exe" Condition="Exists('Tools\ffmpeg.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>ffmpeg.exe</Link>
    </None>
  </ItemGroup>

</Project>
