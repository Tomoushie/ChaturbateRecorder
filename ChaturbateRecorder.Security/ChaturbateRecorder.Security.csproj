<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!--
      Windows uniquement, en connaissance de cause : AclValidator s'appuie sur
      System.Security.AccessControl (ACL NTFS), BinaryVerifier/CertificateValidator
      sur des vérifications Authenticode/certificats propres à Windows. Pas de
      support cross-platform prévu pour l'instant.
    -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <IsPackable>true</IsPackable>
    <PackageId>ChaturbateRecorder.Security</PackageId>
    <Version>1.0.0</Version>
    <Authors>Tomoushie</Authors>
    <Description>Utilitaires de sandbox et de vérification de sécurité pour applications .NET Windows : validation stricte de chemins de fichiers (UNC, ADS, reparse points, noms réservés), validation d'URL par liste blanche/noire, vérification de hash/signature Authenticode de binaires externes, détection d'ACL NTFS permissives, vérification TLS/SAN explicite d'un serveur distant, et détection d'emplacements d'exécution à risque (réseau, temporaire, compressé). Extrait du projet Chaturbate Recorder (https://github.com/Tomoushie/ChaturbateRecorder).</Description>
    <PackageTags>security;sandbox;path-validation;url-validation;acl;authenticode;tls;windows</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Tomoushie/ChaturbateRecorder</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Tomoushie/ChaturbateRecorder</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!--
      SYSLIB0057 : X509Certificate.CreateFromSignedFile(...) est marquée obsolète
      depuis .NET 8, mais reste la seule API de la BCL permettant d'extraire le
      certificat Authenticode signataire d'un binaire PE déjà signé (même choix
      que dans l'application principale ChaturbateRecorderApp).
    -->
    <NoWarn>SYSLIB0057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
